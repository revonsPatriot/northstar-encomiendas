---
import PublicLayout from '../layouts/PublicLayout.astro';

const roles = [
  { value: 'OPERADOR', title: 'Operador', text: 'Emite, recibe y entrega', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { value: 'ENCARGADO_SUCURSAL', title: 'Encargado', text: 'Supervisa y anula guías', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { value: 'ADMIN_CENTRAL', title: 'Administrador', text: 'Control global del sistema', icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5' },
];
---

<PublicLayout title="Crear cuenta · NORTHSTAR">
  <section class="lambo-hero-bg bg-grid-subtle py-12 md:py-20">
    <div class="ns-container grid items-start gap-12 xl:grid-cols-12">
      <!-- Pasos y roles -->
      <div class="animate-fade-up xl:col-span-5">
        <p class="eyebrow">Alta de personal</p>
        <h1 class="display-heading mt-3 text-5xl xl:text-7xl">
          Crea tu<br /><span class="text-gradient">cuenta.</span>
        </h1>
        <p class="mt-4 max-w-md text-base font-medium text-slate-400">
          Elige tu perfil y completa tus datos. Al terminar entrarás directo a tu espacio personal.
        </p>

        <p class="eyebrow mt-9">1 · Elige tu perfil</p>
        <div class="mt-3 space-y-3">
          {roles.map((role, idx) => (
            <button
              type="button"
              data-select-role={role.value}
              class:list={[
                'card-interactive flex w-full items-center gap-4 border bg-[#0b101e] p-4 text-left',
                idx === 0 ? 'border-[#0077ff]' : 'border-white/10',
              ]}
            >
              <span class={idx === 2 ? 'hex-badge hex-badge-violet' : 'hex-badge'}>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={role.icon} />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-extrabold uppercase tracking-wider">{role.title}</span>
                <span class="block text-xs font-medium text-slate-400">{role.text}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Formulario -->
      <div class="xl:col-span-7">
        <div class="ns-panel animate-fade-up mx-auto w-full max-w-3xl p-8 shadow-2xl md:p-10">
          <span class="eyebrow">2 · Tus datos</span>
          <h2 class="display-heading mt-1 text-4xl">Registro de personal</h2>

          <form id="register-form" class="mt-7 space-y-4">
            <label class="block text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">
              Nombre completo
              <input name="fullName" required minlength="3" autocomplete="name" placeholder="Ej. Carlos Mendoza" class="ns-input mt-1.5 py-3" />
            </label>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">
                Cédula de identidad
                <input name="ci" required pattern="[0-9A-Za-z\-]{5,20}" placeholder="Ej. 7654321" class="ns-input mt-1.5 py-3" />
              </label>
              <label class="block text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">
                Sucursal
                <select name="branchId" id="reg-branch" required class="ns-input mt-1.5 py-3">
                  <option value="">Cargando…</option>
                </select>
              </label>
            </div>

            <input type="hidden" name="role" id="reg-role" value="OPERADOR" />

            <div id="access-code-wrap" class="animate-fade-in hidden">
              <label class="block text-xs font-extrabold uppercase tracking-[0.16em] text-[#8b5cf6]">
                Código de autorización
                <input name="accessCode" id="reg-access" autocomplete="off" placeholder="Solicítalo al administrador" class="ns-input mt-1.5 py-3" />
              </label>
              <p class="mt-1 text-xs font-medium text-slate-500">Los perfiles Encargado y Administrador requieren un código interno.</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">
                Contraseña
                <input id="reg-password" name="password" type="password" required minlength="8" autocomplete="new-password" placeholder="Mínimo 8 caracteres" class="ns-input mt-1.5 py-3" />
              </label>
              <label class="block text-xs font-extrabold uppercase tracking-[0.16em] text-slate-400">
                Repite la contraseña
                <input id="reg-password2" type="password" required minlength="8" autocomplete="new-password" placeholder="Confirma tu contraseña" class="ns-input mt-1.5 py-3" />
              </label>
            </div>

            <div>
              <div class="h-1.5 w-full overflow-hidden bg-white/10">
                <div id="strength-bar" class="h-full w-0 bg-red-500 transition-all duration-500"></div>
              </div>
              <p id="strength-label" class="mt-1 text-[11px] font-bold uppercase tracking-wider text-slate-500">Seguridad de la contraseña</p>
            </div>

            <p id="register-error" role="alert" class="animate-fade-in hidden border border-red-500/30 bg-red-950/30 p-3 text-sm font-semibold text-red-300"></p>

            <button id="register-submit" class="ns-btn-primary w-full py-4 text-base">
              <span id="register-label">Crear cuenta y entrar</span>
              <span>→</span>
            </button>
          </form>

          <p class="mt-7 border-t border-white/10 pt-5 text-center text-sm font-medium text-slate-400">
            ¿Ya tienes una cuenta?
            <a href="/login" class="font-bold text-[#0077ff] hover:underline">Inicia sesión</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { apiFetch, saveSession } from '../services/api-client';
    import { listBranches } from '../services/shipment.service';
    import type { LoginResponse } from '../../../shared/types/shipment.types';

    const form = document.querySelector<HTMLFormElement>('#register-form');
    const errorBox = document.querySelector<HTMLElement>('#register-error');
    const branchSelect = document.querySelector<HTMLSelectElement>('#reg-branch');
    const roleInput = document.querySelector<HTMLInputElement>('#reg-role');
    const accessWrap = document.querySelector<HTMLElement>('#access-code-wrap');
    const accessInput = document.querySelector<HTMLInputElement>('#reg-access');
    const roleCards = document.querySelectorAll<HTMLButtonElement>('[data-select-role]');
    const password = document.querySelector<HTMLInputElement>('#reg-password');
    const password2 = document.querySelector<HTMLInputElement>('#reg-password2');
    const bar = document.querySelector<HTMLElement>('#strength-bar');
    const strengthLabel = document.querySelector<HTMLElement>('#strength-label');
    const label = document.querySelector<HTMLElement>('#register-label');

    roleCards.forEach((card) => {
      card.addEventListener('click', () => {
        const role = card.dataset.selectRole ?? 'OPERADOR';
        if (roleInput) roleInput.value = role;
        const elevated = role !== 'OPERADOR';
        accessWrap?.classList.toggle('hidden', !elevated);
        if (accessInput) accessInput.required = elevated;
        roleCards.forEach((c) => {
          c.classList.toggle('border-[#0077ff]', c === card);
          c.classList.toggle('border-white/10', c !== card);
        });
      });
    });

    password?.addEventListener('input', () => {
      const value = password.value;
      let score = 0;
      if (value.length >= 8) score += 1;
      if (value.length >= 12) score += 1;
      if (/[A-Z]/.test(value) && /[a-z]/.test(value)) score += 1;
      if (/\d/.test(value)) score += 1;
      if (/[^A-Za-z0-9]/.test(value)) score += 1;
      const levels = [
        { w: '8%', c: '#ef4444', t: 'Muy débil' },
        { w: '25%', c: '#ef4444', t: 'Débil' },
        { w: '50%', c: '#f59e0b', t: 'Aceptable' },
        { w: '75%', c: '#0077ff', t: 'Buena' },
        { w: '90%', c: '#10b981', t: 'Fuerte' },
        { w: '100%', c: '#10b981', t: 'Excelente' },
      ];
      const level = value ? levels[score] : { w: '0%', c: '#ef4444', t: 'Seguridad de la contraseña' };
      if (bar) {
        bar.style.width = level.w;
        bar.style.background = level.c;
      }
      if (strengthLabel) strengthLabel.textContent = level.t;
    });

    listBranches()
      .then((branches) => {
        if (!branchSelect) return;
        branchSelect.innerHTML =
          '<option value="">Selecciona tu sucursal</option>' +
          branches.map((b) => `<option value="${b.id}">${b.code} · ${b.name}</option>`).join('');
      })
      .catch(() => {
        if (branchSelect) branchSelect.innerHTML = '<option value="">Sin conexión con el servidor</option>';
      });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = document.querySelector<HTMLButtonElement>('#register-submit');
      const data = new FormData(form);
      errorBox?.classList.add('hidden');

      if (password && password2 && password.value !== password2.value) {
        if (errorBox) {
          errorBox.textContent = 'Las contraseñas no coinciden.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      if (submit) submit.disabled = true;
      if (label) label.textContent = 'Creando tu cuenta…';
      try {
        const role = String(data.get('role') ?? 'OPERADOR');
        const session = await apiFetch<LoginResponse>('/auth/register', {
          method: 'POST',
          body: JSON.stringify({
            fullName: data.get('fullName'),
            ci: data.get('ci'),
            branchId: data.get('branchId'),
            role,
            password: data.get('password'),
            accessCode: role !== 'OPERADOR' ? data.get('accessCode') : undefined,
          }),
        });
        saveSession(session.accessToken, session.user);
        window.location.href = '/sucursal/mi-cuenta?bienvenida=1';
      } catch (requestError) {
        if (errorBox) {
          errorBox.textContent = requestError instanceof Error ? requestError.message : 'No se pudo registrar la cuenta.';
          errorBox.classList.remove('hidden');
        }
        if (submit) submit.disabled = false;
        if (label) label.textContent = 'Crear cuenta y entrar';
      }
    });
  </script>
</PublicLayout>
