---
import '../styles/global.css';

const { title = 'NORTHSTAR · Red Logística de Alto Rendimiento' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050811" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var saved = localStorage.getItem('northstar_theme');
          var theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Top Bar: ☰ MENÚ a la izquierda, Escudo al centro, Acciones a la derecha -->
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0b101e]/95 backdrop-blur-md">
      <div class="ns-container grid grid-cols-3 items-center py-4">
        <div class="flex items-center gap-6">
          <button
            type="button"
            id="lambo-menu-toggle"
            aria-expanded="false"
            class="btn-tactile inline-flex items-center gap-3 text-xs font-extrabold uppercase tracking-[0.22em] text-white hover:text-[#0077ff]"
          >
            <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 7h18M3 12h14M3 17h18" />
            </svg>
            <svg id="menu-icon-close" class="hidden h-5 w-5 text-[#0077ff]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
            <span id="menu-label">MENÚ</span>
          </button>

          <nav class="hidden items-center gap-6 text-xs font-bold uppercase tracking-[0.18em] text-slate-400 xl:flex">
            <a href="/" class:list={['transition hover:text-[#0077ff]', currentPath === '/' ? 'text-[#0077ff]' : '']}>Inicio y Mapa</a>
            <a href="/rutas" class:list={['transition hover:text-[#0077ff]', currentPath.startsWith('/rutas') ? 'text-[#0077ff]' : '']}>Rutas y Cotizador</a>
            <a href="/servicios" class:list={['transition hover:text-[#0077ff]', currentPath.startsWith('/servicios') ? 'text-[#0077ff]' : '']}>Servicios</a>
          </nav>
        </div>

        <div class="flex justify-center">
          <a href="/" class="brand-mark">
            <span class="brand-emblem">N</span>
            <span class="hidden sm:inline">NORTHSTAR</span>
          </a>
        </div>

        <div class="flex items-center justify-end gap-3">
          <button
            type="button"
            id="theme-toggle"
            aria-label="Cambiar modo claro u oscuro"
            class="hex-btn"
            title="Cambiar tema Light / Dark"
          >
            <svg id="theme-icon-sun" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg id="theme-icon-moon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>

          <a
            href="/registro"
            id="nav-register-cta"
            class:list={[
              'ns-btn-outline hidden sm:inline-flex',
              currentPath.startsWith('/registro') ? 'border-[#0077ff] text-[#0077ff]' : '',
            ]}
          >
            Registro
          </a>

          <a
            href="/login"
            id="nav-auth-cta"
            class="ns-btn-primary"
          >
            <span>Acceso</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Slidebar / Full-Screen Overlay Menu -->
    <div
      id="lambo-slide-menu"
      class="fixed inset-x-0 top-[69px] bottom-0 z-50 hidden overflow-y-auto bg-[#0b101e]/95 backdrop-blur-xl"
    >
      <div class="ns-container flex min-h-full flex-col justify-between py-12">
        <div class="grid gap-x-12 gap-y-3 md:grid-cols-3">
          <a href="/" class="lambo-menu-link">
            <span>RASTREO Y MAPA EN VIVO</span>
            <span class="text-[#0077ff]">›</span>
          </a>
          <a href="/rutas" class="lambo-menu-link">
            <span>MAPA DE RUTAS Y TARIFAS</span>
            <span class="text-[#0077ff]">›</span>
          </a>
          <a href="/servicios" class="lambo-menu-link">
            <span>SERVICIOS CORPORATIVOS</span>
            <span class="text-[#0077ff]">›</span>
          </a>
          <a href="/rutas#oficinas" class="lambo-menu-link">
            <span>DIRECTORIO DE SUCURSALES</span>
            <span class="text-[#0077ff]">›</span>
          </a>
          <a href="/login" class="lambo-menu-link">
            <span>PÁGINA DE ACCESO (LOGIN)</span>
            <span class="text-[#0077ff]">›</span>
          </a>
          <a href="/registro" class="lambo-menu-link">
            <span>PÁGINA DE REGISTRO</span>
            <span class="text-[#0077ff]">›</span>
          </a>
          <a href="/sucursal/dashboard" class="lambo-menu-link">
            <span>PANEL DE SUCURSAL</span>
            <span class="text-[#0077ff]">›</span>
          </a>
          <a href="/sucursal/mi-cuenta" class="lambo-menu-link">
            <span>MI CUENTA PERSONAL</span>
            <span class="text-[#8b5cf6]">›</span>
          </a>
          <a href="/sucursal/admin" class="lambo-menu-link">
            <span>ADMINISTRACIÓN CENTRAL</span>
            <span class="text-[#0077ff]">›</span>
          </a>
        </div>

        <div class="mt-12 border-t border-white/15 pt-8">
          <div class="grid gap-6 text-xs font-bold uppercase tracking-[0.16em] text-slate-400 sm:grid-cols-3">
            <div class="border-b border-white/10 pb-3">
              <span class="block text-[10px] text-[#0077ff]">RED CONECTADA</span>
              <span class="mt-1 block text-white">COCHABAMBA · SANTA CRUZ · LA PAZ · EL ALTO · ORURO</span>
            </div>
            <div class="border-b border-white/10 pb-3">
              <span class="block text-[10px] text-[#0077ff]">MODALIDADES</span>
              <span class="mt-1 block text-white">PAGADO ORIGEN · POR PAGAR · CRÉDITO CORPORATIVO</span>
            </div>
            <div class="border-b border-white/10 pb-3">
              <span class="block text-[10px] text-[#0077ff]">SEGURIDAD</span>
              <span class="mt-1 block text-white">TRAZABILIDAD QR · ENTREGA VERIFICADA CON C.I.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-[#0b101e] py-8">
      <div class="ns-container flex flex-wrap items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="brand-mark text-base">
            <span class="brand-emblem">N</span>
            <span>NORTHSTAR</span>
          </div>
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">
            BOLIVIA · HIGH PERFORMANCE LOGISTICS
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-6 text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          <a href="/" class="hover:text-[#0077ff]">Mapa y Rastreo</a>
          <a href="/rutas" class="hover:text-[#0077ff]">Rutas</a>
          <a href="/servicios" class="hover:text-[#0077ff]">Servicios</a>
          <a href="/login" class="hover:text-[#0077ff]">Acceso</a>
          <a href="/registro" class="hover:text-[#0077ff]">Registro</a>
        </div>
      </div>
    </footer>

    <script>
      function syncThemeButton() {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const sun = document.querySelector('#theme-icon-sun');
        const moon = document.querySelector('#theme-icon-moon');
        if (current === 'light') {
          sun?.classList.remove('hidden');
          moon?.classList.add('hidden');
        } else {
          sun?.classList.add('hidden');
          moon?.classList.remove('hidden');
        }
      }

      syncThemeButton();

      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('northstar_theme', next);
        syncThemeButton();
      });

      // Aparición suave de las secciones al hacer scroll.
      const revealables = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-visible'));
      }

      const menuBtn = document.querySelector('#lambo-menu-toggle');
      const slideMenu = document.querySelector('#lambo-slide-menu');
      const iconOpen = document.querySelector('#menu-icon-open');
      const iconClose = document.querySelector('#menu-icon-close');
      const menuLabel = document.querySelector('#menu-label');

      menuBtn?.addEventListener('click', () => {
        const isHidden = slideMenu?.classList.contains('hidden');
        slideMenu?.classList.toggle('hidden', !isHidden);
        slideMenu?.classList.toggle('animate-fade-in', Boolean(isHidden));
        iconOpen?.classList.toggle('hidden', Boolean(isHidden));
        iconClose?.classList.toggle('hidden', !isHidden);
        if (menuLabel) menuLabel.textContent = isHidden ? 'CERRAR' : 'MENÚ';
      });

      slideMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          slideMenu.classList.add('hidden');
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
          if (menuLabel) menuLabel.textContent = 'MENÚ';
        });
      });

      const hasSession =
        Boolean(localStorage.getItem('northstar_access_token')) &&
        Boolean(localStorage.getItem('northstar_user'));
      const cta = document.querySelector<HTMLAnchorElement>('#nav-auth-cta');
      const regCta = document.querySelector<HTMLAnchorElement>('#nav-register-cta');
      if (
        hasSession &&
        cta &&
        window.location.pathname !== '/login' &&
        window.location.pathname !== '/registro'
      ) {
        cta.innerHTML = '<span>Panel</span><span>→</span>';
        cta.href = '/sucursal/dashboard';
        regCta?.classList.add('hidden');
      }
    </script>
  </body>
</html>
