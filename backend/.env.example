DATABASE_URL=postgresql://user:password@localhost:5432/northstar
DIRECT_URL=postgresql://user:password@localhost:5432/northstar
# Mínimo 32 caracteres aleatorios
JWT_SECRET=change-me-to-a-long-random-secret-value
PORT=3000
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:4321
# Código interno para registrar cuentas ENCARGADO_SUCURSAL o ADMIN_CENTRAL desde /registro.
# Si no se define, solo se pueden registrar operadores.
STAFF_REGISTRATION_CODE=revonsEncomiendas
